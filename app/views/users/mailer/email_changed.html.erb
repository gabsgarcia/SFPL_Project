<p>Olá, <%= @email %>!</p>

<% if @resource.try(:unconfirmed_email?) %>
  <p>Estamos informando que seu endereço de e-mail está sendo alterado para <strong><%= @resource.unconfirmed_email %></strong>.</p>
<% else %>
  <p>Estamos informando que seu endereço de e-mail foi alterado para <strong><%= @resource.email %></strong>.</p>
<% end %>
