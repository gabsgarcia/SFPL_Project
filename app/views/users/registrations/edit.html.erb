<h2>Editar conta</h2>

<%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :email, label: "E-mail", required: true, autofocus: true %>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p class="text-muted small">Aguardando confirmação para: <%= resource.unconfirmed_email %></p>
    <% end %>

    <div class="mb-3" data-controller="password-visibility">
      <%= f.label :password, "Nova senha", class: "form-label" %>
      <div class="input-group">
        <%= f.password_field :password,
                              class: "form-control",
                              data: { password_visibility_target: "input" },
                              autocomplete: "new-password" %>
        <button class="btn btn-outline-secondary" type="button"
                data-action="click->password-visibility#toggle">
          <i class="fa-solid fa-eye" data-password-visibility-target="icon"></i>
        </button>
      </div>
      <div class="form-text">Deixe em branco para não alterar</div>
    </div>

    <div class="mb-3" data-controller="password-visibility">
      <%= f.label :password_confirmation, "Confirmar nova senha", class: "form-label" %>
      <div class="input-group">
        <%= f.password_field :password_confirmation,
                              class: "form-control",
                              data: { password_visibility_target: "input" },
                              autocomplete: "new-password" %>
        <button class="btn btn-outline-secondary" type="button"
                data-action="click->password-visibility#toggle">
          <i class="fa-solid fa-eye" data-password-visibility-target="icon"></i>
        </button>
      </div>
    </div>

    <div class="mb-3" data-controller="password-visibility">
      <%= f.label :current_password, "Senha atual", class: "form-label" %>
      <div class="input-group">
        <%= f.password_field :current_password,
                              class: "form-control",
                              data: { password_visibility_target: "input" },
                              autocomplete: "current-password",
                              required: true %>
        <button class="btn btn-outline-secondary" type="button"
                data-action="click->password-visibility#toggle">
          <i class="fa-solid fa-eye" data-password-visibility-target="icon"></i>
        </button>
      </div>
      <div class="form-text">Informe sua senha atual para confirmar as alterações</div>
    </div>
  </div>

  <div class="form-actions">
    <%= f.button :submit, "Atualizar conta" %>
  </div>
<% end %>

<hr class="my-4">

<h3>Cancelar minha conta</h3>
<p class="text-muted">Esta ação é irreversível. Todos os seus dados serão removidos.</p>
<%= button_to "Cancelar minha conta", registration_path(resource_name),
    data: { turbo_confirm: "Tem certeza? Esta ação não pode ser desfeita." },
    method: :delete,
    class: "btn btn-outline-danger btn-sm" %>

<div class="mt-3">
  <%= link_to "Voltar", :back, class: "btn btn-outline-secondary btn-sm" %>
</div>
