<h2>Criar conta</h2>

<%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :first_name, label: "Nome", required: true %>
    <%= f.input :last_name, label: "Sobrenome", required: true %>
    <%= f.input :email,
                required: true,
                autofocus: true,
                input_html: { autocomplete: "email" } %>
    <div class="mb-3" data-controller="password-visibility">
      <%= f.label :password, "Senha", class: "form-label" %>
      <div class="input-group">
        <%= f.password_field :password,
                              class: "form-control",
                              data: { password_visibility_target: "input" },
                              autocomplete: "new-password",
                              required: true %>
        <button class="btn btn-outline-secondary" type="button"
                data-action="click->password-visibility#toggle">
          <i class="fa-solid fa-eye" data-password-visibility-target="icon"></i>
        </button>
      </div>
      <% if @minimum_password_length %>
        <div class="form-text">Mínimo de <%= @minimum_password_length %> caracteres</div>
      <% end %>
    </div>

    <div class="mb-3" data-controller="password-visibility">
      <%= f.label :password_confirmation, "Confirmar senha", class: "form-label" %>
      <div class="input-group">
        <%= f.password_field :password_confirmation,
                              class: "form-control",
                              data: { password_visibility_target: "input" },
                              autocomplete: "new-password",
                              required: true %>
        <button class="btn btn-outline-secondary" type="button"
                data-action="click->password-visibility#toggle">
          <i class="fa-solid fa-eye" data-password-visibility-target="icon"></i>
        </button>
      </div>
    </div>
    <%= f.input :photo, as: :file, required: false, label: "Foto de perfil (opcional)" %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, "Criar conta" %>
  </div>
<% end %>

<%= render "users/shared/links" %>
