<h2>Change your password</h2>

<%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= f.error_notification %>

  <%= f.input :reset_password_token, as: :hidden %>
  <%= f.full_error :reset_password_token %>

  <div class="form-inputs">
    <div class="mb-3" data-controller="password-visibility">
      <%= f.label :password, "New password", class: "form-label" %>
      <div class="input-group">
        <%= f.password_field :password,
                              class: "form-control",
                              data: { password_visibility_target: "input" },
                              autocomplete: "new-password",
                              autofocus: true,
                              required: true %>
        <button class="btn btn-outline-secondary" type="button"
                data-action="click->password-visibility#toggle">
          <i class="fa-solid fa-eye" data-password-visibility-target="icon"></i>
        </button>
      </div>
      <% if @minimum_password_length %>
        <div class="form-text"><%= @minimum_password_length %> characters minimum</div>
      <% end %>
    </div>

    <div class="mb-3" data-controller="password-visibility">
      <%= f.label :password_confirmation, "Confirm your new password", class: "form-label" %>
      <div class="input-group">
        <%= f.password_field :password_confirmation,
                              class: "form-control",
                              data: { password_visibility_target: "input" },
                              autocomplete: "new-password",
                              required: true %>
        <button class="btn btn-outline-secondary" type="button"
                data-action="click->password-visibility#toggle">
          <i class="fa-solid fa-eye" data-password-visibility-target="icon"></i>
        </button>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= f.button :submit, "Change my password" %>
  </div>
<% end %>

<%= render "users/shared/links" %>
