<% badge_class = {
  "novo"                   => "bg-secondary",
  "extraindo_dados"        => "bg-warning text-dark",
  "docs_base_prontos"      => "bg-primary",
  "aguardando_visita"      => "bg-info text-dark",
  "processando_pos_visita" => "bg-warning text-dark",
  "pre_laudo_em_revisao"   => "bg-info text-dark",
  "pre_laudo_aprovado"     => "bg-primary",
  "concluido"              => "bg-success",
  "erro"                   => "bg-danger"
}.fetch(pericia.status, "bg-secondary") %>

<% label = {
  "novo"                   => "Novo",
  "extraindo_dados"        => "Extraindo dados...",
  "docs_base_prontos"      => "Documentos prontos",
  "aguardando_visita"      => "Aguardando visita",
  "processando_pos_visita" => "Processando pós-visita",
  "pre_laudo_em_revisao"   => "Pré-laudo em revisão",
  "pre_laudo_aprovado"     => "Pré-laudo aprovado",
  "concluido"              => "Concluído",
  "erro"                   => "Erro"
}.fetch(pericia.status, pericia.status) %>

<span class="badge <%= badge_class %>"><%= label %></span>
