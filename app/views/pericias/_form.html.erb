<%= simple_form_for pericia, html: { multipart: true } do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].any? %>

  <div class="mb-4">
    <%= f.input :numero_processo,
        label: "Número do processo",
        placeholder: "Ex: 1001760-11.2025.5.02.0292",
        hint: "Número completo conforme consta no sistema do TRT" %>
  </div>

  <div class="mb-4">
    <%= f.input :arquivo_processo,
        as: :file,
        label: "PDF do processo judicial",
        hint: "O agente de IA irá extrair automaticamente os dados das partes, e-mails dos advogados, quesitos e tipo de perícia.",
        input_html: { accept: "application/pdf" } %>
  </div>

  <div class="mb-4">
    <%= f.input :observacoes_perito,
        label: "Observações internas",
        as: :text,
        input_html: { rows: 3 },
        hint: "Notas internas — não aparecem no laudo",
        required: false %>
  </div>

  <div class="d-flex gap-2">
    <%= f.button :submit, class: "btn btn-primary" %>
    <%= link_to "Cancelar", pericias_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
