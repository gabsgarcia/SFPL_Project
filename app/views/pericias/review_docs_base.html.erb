<div class="container mt-4">

  <%# Cabeçalho %>
  <div class="d-flex justify-content-between align-items-start mb-4">
    <div>
      <h1 class="h3 mb-1">Revisão dos Documentos — Fase 1</h1>
      <p class="text-muted mb-0">
        <%= @pericia.numero_processo %> &mdash;
        <%= @pericia.reclamante.presence || "Reclamante não identificado" %> ×
        <%= @pericia.reclamada_1.presence || "Reclamada não identificada" %>
      </p>
    </div>
    <%= link_to "Voltar ao processo", @pericia, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <%# Barra de progresso %>
  <% revisados = @documento_bases.count(&:revisado?) %>
  <% total = @documento_bases.count %>
  <div class="card mb-4">
    <div class="card-body py-3">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="fw-semibold">Progresso da revisão</span>
        <span class="text-muted small"><%= revisados %>/<%= total %> documentos revisados</span>
      </div>
      <div class="progress" style="height: 10px;">
        <div class="progress-bar bg-success"
             style="width: <%= total > 0 ? (revisados * 100 / total) : 0 %>%"
             role="progressbar">
        </div>
      </div>
    </div>
  </div>

  <%# Tabs dos ARQs %>
  <% if @documento_bases.any? %>
    <ul class="nav nav-tabs mb-0" id="arqTabs" role="tablist">
      <% @documento_bases.each_with_index do |doc, i| %>
        <li class="nav-item" role="presentation">
          <button class="nav-link <%= i == 0 ? "active" : "" %> d-flex align-items-center gap-2"
                  id="tab-<%= doc.tipo %>"
                  data-bs-toggle="tab"
                  data-bs-target="#pane-<%= doc.tipo %>"
                  type="button"
                  role="tab">
            <%= doc.tipo.split("_").first.upcase %>
            <% if doc.revisado? %>
              <span class="badge bg-success rounded-pill" style="font-size: 0.65rem;">&#10003;</span>
            <% else %>
              <span class="badge bg-warning text-dark rounded-pill" style="font-size: 0.65rem;">!</span>
            <% end %>
          </button>
        </li>
      <% end %>
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom p-4 bg-white mb-4" id="arqTabsContent">
      <% @documento_bases.each_with_index do |doc, i| %>
        <div class="tab-pane fade <%= i == 0 ? "show active" : "" %>"
             id="pane-<%= doc.tipo %>"
             role="tabpanel">

          <%# Cabeçalho do tab %>
          <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
              <h5 class="mb-1"><%= doc.label %></h5>
              <% if doc.revisado? %>
                <span class="badge bg-success">Revisado em <%= l(doc.revisado_em, format: :short) %></span>
              <% else %>
                <span class="badge bg-warning text-dark">Pendente de revisão</span>
              <% end %>
            </div>
            <div class="d-flex gap-2">
              <%= link_to "Editar",
                    edit_pericia_documento_base_path(@pericia, doc),
                    class: "btn btn-outline-primary btn-sm" %>
              <% unless doc.revisado? %>
                <%= button_to "Marcar como revisado",
                      marcar_revisado_pericia_documento_base_path(@pericia, doc),
                      method: :post,
                      class: "btn btn-success btn-sm" %>
              <% end %>
              <% if doc.exporta_pdf? %>
                <%= link_to "Exportar PDF",
                      export_pdf_pericia_documento_base_path(@pericia, doc),
                      class: "btn btn-outline-secondary btn-sm",
                      data: { turbo: false } %>
              <% elsif doc.exporta_texto? %>
                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        data-controller="clipboard"
                        data-clipboard-text-value="<%= j(doc.conteudo) %>"
                        data-action="click->clipboard#copy">
                  Copiar e-mail
                </button>
              <% end %>
            </div>
          </div>

          <%# Conteúdo do documento %>
          <% if doc.conteudo.present? %>
            <pre class="bg-light border rounded p-3 mb-0"
                 style="white-space: pre-wrap; font-family: 'Courier New', monospace; font-size: 0.875rem; line-height: 1.6; max-height: 500px; overflow-y: auto;"><%= doc.conteudo %></pre>
          <% else %>
            <div class="alert alert-warning mb-0">
              Este documento ainda não foi gerado. Tente reprocessar o PDF do processo.
            </div>
          <% end %>

        </div>
      <% end %>
    </div>

  <% else %>
    <div class="alert alert-warning">
      <strong>Documentos ainda não gerados.</strong>
      <% if @pericia.arquivo_processo.attached? %>
        <%= button_to "Reprocessar PDF",
              extract_processo_pericia_path(@pericia),
              method: :post,
              class: "btn btn-warning btn-sm ms-2" %>
      <% else %>
        <%= link_to "Voltar e fazer upload", @pericia, class: "btn btn-warning btn-sm ms-2" %>
      <% end %>
    </div>
  <% end %>

  <%# Botão de confirmação final %>
  <div class="d-flex justify-content-between align-items-center">
    <%= link_to "Voltar ao processo", @pericia, class: "btn btn-outline-secondary" %>
    <% if revisados == total && total == 4 %>
      <%= button_to "Confirmar envio e avançar para Fase 2",
            confirmar_fase1_pericia_path(@pericia),
            method: :post,
            class: "btn btn-primary",
            form: { data: { turbo_confirm: "Confirmar que os documentos foram enviados ao juiz e advogados?" } } %>
    <% else %>
      <button class="btn btn-primary" disabled
              title="Revise todos os <%= total %> documentos para prosseguir">
        Confirmar envio e avançar para Fase 2
        <span class="badge bg-light text-dark ms-1"><%= revisados %>/<%= total %></span>
      </button>
    <% end %>
  </div>

</div>
