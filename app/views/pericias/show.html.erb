<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-start mb-4">
    <div>
      <h1 class="h3 mb-1"><%= @pericia.numero_processo %></h1>
      <p class="text-muted mb-0">
        <%= @pericia.reclamante %> × <%= @pericia.reclamada_1 %>
        <% if @pericia.reclamada_2.present? %> / <%= @pericia.reclamada_2 %><% end %>
      </p>
      <p class="text-muted small mb-0">
        <%= @pericia.vara.presence || "Vara não informada" %> —
        <%= @pericia.comarca.presence || "Comarca não informada" %>
      </p>
    </div>
    <div class="d-flex gap-2 align-items-center">
      <%= render "status_badge", pericia: @pericia %>
      <%= link_to "Editar", edit_pericia_path(@pericia), class: "btn btn-outline-secondary btn-sm" %>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h6 class="card-subtitle text-muted mb-2">Tipo de perícia</h6>
          <p class="mb-0">
            <% tipo = { "insalubridade" => "Insalubridade", "periculosidade" => "Periculosidade", "ambos" => "Insalubridade + Periculosidade" } %>
            <%= tipo[@pericia.tipo_pericia] || "Não definido" %>
          </p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h6 class="card-subtitle text-muted mb-2">Função do reclamante</h6>
          <p class="mb-0"><%= @pericia.funcao_reclamante.presence || "Não informada" %></p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h6 class="card-subtitle text-muted mb-2">Visita pericial</h6>
          <p class="mb-0">
            <% if @pericia.data_pericia.present? %>
              <%= l(@pericia.data_pericia, format: :default) %>
            <% else %>
              Não agendada
            <% end %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <% agentes = @pericia.agentes_selecionados %>
  <% if agentes.any? %>
    <div class="mb-4">
      <h6 class="text-muted mb-2">Agentes de risco</h6>
      <div class="d-flex flex-wrap gap-2">
        <% labels = { "ruido" => "Ruído", "calor" => "Calor", "quimico" => "Químico", "biologico" => "Biológico", "eletricidade" => "Eletricidade", "inflamavel" => "Inflamável", "ergonomia" => "Ergonomia" } %>
        <% agentes.each do |a| %>
          <span class="badge bg-secondary"><%= labels[a] %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <strong>Documentos</strong>
      <span class="badge bg-light text-dark"><%= @pericia.pericia_documents.count %></span>
    </div>
    <div class="card-body">
      <% if @pericia.pericia_documents.empty? %>
        <p class="text-muted mb-0">Nenhum documento enviado ainda.</p>
      <% else %>
        <ul class="list-group list-group-flush">
          <% @pericia.pericia_documents.each do |doc| %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span>
                <span class="badge bg-secondary me-2"><%= doc.label %></span>
                <%= doc.nome_original %>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <strong>Laudo gerado</strong>
    </div>
    <div class="card-body">
      <% if @pericia.laudo_sections.empty? %>
        <p class="text-muted mb-0">O laudo ainda não foi gerado. Faça o upload dos documentos e inicie a geração.</p>
      <% else %>
        <%= render @pericia.laudo_sections %>
      <% end %>
    </div>
  </div>

  <div class="mt-3">
    <%= link_to "Voltar para perícias", pericias_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>
