<div class="container mt-4">

  <%# Cabeçalho do processo %>
  <div class="d-flex justify-content-between align-items-start mb-4">
    <div>
      <h1 class="h3 mb-1"><%= @pericia.numero_processo %></h1>
      <p class="text-muted mb-0">
        <%= @pericia.reclamante %> × <%= @pericia.reclamada_1 %>
        <% if @pericia.reclamada_2.present? %> / <%= @pericia.reclamada_2 %><% end %>
      </p>
      <p class="text-muted small mb-0">
        <%= @pericia.vara.presence || "Vara não informada" %> —
        <%= @pericia.comarca.presence || "Comarca não informada" %>
      </p>
    </div>
    <div class="d-flex gap-2 align-items-center">
      <%= render "status_badge", pericia: @pericia %>
      <%= link_to "Editar", edit_pericia_path(@pericia), class: "btn btn-outline-secondary btn-sm" %>
    </div>
  </div>

  <%# Cards de resumo %>
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h6 class="card-subtitle text-muted mb-2">Tipo de perícia</h6>
          <% tipo = { "insalubridade" => "Insalubridade", "periculosidade" => "Periculosidade", "ambos" => "Insalubridade + Periculosidade" } %>
          <p class="mb-0"><%= tipo[@pericia.tipo_pericia] || "Não definido" %></p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h6 class="card-subtitle text-muted mb-2">Função do reclamante</h6>
          <p class="mb-0"><%= @pericia.funcao_reclamante.presence || "Não informada" %></p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h6 class="card-subtitle text-muted mb-2">Visita pericial</h6>
          <p class="mb-0">
            <% if @pericia.data_pericia.present? %>
              <%= l(@pericia.data_pericia, format: :default) %>
            <% else %>
              Não agendada
            <% end %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <%# Agentes de risco %>
  <% agentes = @pericia.agentes_selecionados %>
  <% if agentes.any? %>
    <div class="mb-4">
      <h6 class="text-muted mb-2">Agentes de risco</h6>
      <% labels = { "ruido" => "Ruído", "calor" => "Calor", "quimico" => "Químico", "biologico" => "Biológico", "eletricidade" => "Eletricidade", "inflamavel" => "Inflamável", "ergonomia" => "Ergonomia" } %>
      <div class="d-flex flex-wrap gap-2">
        <% agentes.each do |a| %>
          <span class="badge bg-secondary"><%= labels[a] %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Fase 1 — Extração de dados %>
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <strong>Fase 1 — Extração de dados</strong>
      <%= render "status_badge", pericia: @pericia %>
    </div>
    <div class="card-body">
      <% case @pericia.status %>
      <% when "novo" %>
        <p class="text-muted mb-3">PDF enviado. Clique para extrair os dados do processo com IA.</p>
        <%= button_to "Extrair dados com IA",
              extract_processo_pericia_path(@pericia),
              method: :post,
              class: "btn btn-primary btn-sm",
              form: { data: { turbo_confirm: "Iniciar extração? O agente irá ler o PDF e preencher os documentos automaticamente." } } %>
      <% when "extraindo_dados" %>
        <div class="d-flex align-items-center gap-2 text-muted">
          <div class="spinner-border spinner-border-sm" role="status"></div>
          <span>Extraindo dados do processo — aguarde alguns instantes...</span>
        </div>
      <% when "docs_base_prontos" %>
        <p class="text-muted mb-3">Dados extraídos. Revise os 4 documentos antes de confirmar o envio.</p>
        <%= link_to "Revisar documentos (ARQ 1-4)", review_docs_base_pericia_path(@pericia), class: "btn btn-primary btn-sm" %>
      <% when "aguardando_visita" %>
        <div class="alert alert-success py-2 mb-0">
          Documentos enviados. Aguardando a visita pericial.
        </div>
      <% when "erro" %>
        <div class="alert alert-danger py-2 mb-3">
          Ocorreu um erro durante a extração. Verifique se o PDF está correto e tente novamente.
        </div>
        <%= button_to "Tentar novamente",
              extract_processo_pericia_path(@pericia),
              method: :post,
              class: "btn btn-warning btn-sm" %>
      <% else %>
        <p class="text-muted mb-0">Fase 1 concluída.</p>
      <% end %>
    </div>
  </div>

  <%# Documentos %>
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <strong>Documentos</strong>
      <span class="badge bg-light text-dark"><%= @pericia.pericia_documents.count %></span>
    </div>
    <div class="card-body">

      <%# Lista de documentos existentes %>
      <% if @pericia.pericia_documents.any? %>
        <ul class="list-group list-group-flush mb-4">
          <% @pericia.pericia_documents.each do |doc| %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span class="d-flex align-items-center gap-2">
                <span class="badge bg-secondary"><%= doc.label %></span>
                <%= doc.nome_original %>
                <% if doc.processado? %>
                  <% if doc.texto_extraido&.start_with?("[Erro") %>
                    <span class="badge bg-danger">Erro na extração</span>
                  <% elsif doc.texto_extraido.present? %>
                    <span class="badge bg-success">Texto extraído</span>
                  <% else %>
                    <span class="badge bg-light text-muted">Sem texto</span>
                  <% end %>
                <% else %>
                  <span class="badge bg-warning text-dark">Processando...</span>
                <% end %>
              </span>
              <%= button_to "Remover",
                    pericia_pericia_document_path(@pericia, doc),
                    method: :delete,
                    class: "btn btn-sm btn-outline-danger",
                    form: { data: { turbo_confirm: "Remover este documento?" } } %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-muted small mb-4">Nenhum documento enviado ainda.</p>
      <% end %>

      <%# Formulário de upload %>
      <hr class="mb-3">
      <h6 class="mb-3">Enviar novo documento</h6>
      <%= simple_form_for [@pericia, PericiaDocument.new] do |f| %>
        <div class="row g-2 align-items-end">
          <div class="col-md-4">
            <%= f.input :document_type,
                  label: "Tipo de documento",
                  as: :select,
                  collection: PericiaDocument::DOCUMENT_TYPES.map { |t| [PericiaDocument::LABELS[t], t] },
                  include_blank: "Selecione o tipo..." %>
          </div>
          <div class="col-md-6">
            <%= f.input :file, label: "Arquivo", as: :file %>
          </div>
          <div class="col-md-2 mt-auto pb-3">
            <%= f.button :submit, "Enviar", class: "btn btn-primary w-100" %>
          </div>
        </div>
      <% end %>

    </div>
  </div>

  <%# Laudo gerado %>
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <strong>Laudo</strong>
      <% if @pericia.status.in?(%w[pre_laudo_em_revisao pre_laudo_aprovado concluido]) %>
        <%= link_to "Revisar laudo", review_pericia_path(@pericia), class: "btn btn-sm btn-primary" %>
      <% end %>
    </div>
    <div class="card-body">
      <% if @pericia.laudo_sections.empty? %>
        <p class="text-muted mb-2">O laudo ainda não foi gerado.</p>
        <% if @pericia.transcricao_limpa.present? && !@pericia.transcricao_revisada? %>
          <div class="alert alert-warning py-2 mb-2">
            Transcrição processada. Revise os dados antes de gerar o laudo.
          </div>
          <%= link_to "Revisar transcrição", review_transcricao_pericia_path(@pericia), class: "btn btn-warning btn-sm" %>
        <% elsif @pericia.pronta_para_gerar_laudo? %>
          <%= button_to "Gerar laudo com IA",
                generate_laudo_pericia_path(@pericia),
                method: :post,
                class: "btn btn-success btn-sm",
                form: { data: { turbo_confirm: "Iniciar geração do laudo? Isso pode levar alguns minutos." } } %>
        <% else %>
          <p class="text-muted small mb-0">Faça o upload dos documentos e da transcrição para habilitar a geração.</p>
        <% end %>
      <% else %>
        <% revisadas = @pericia.laudo_sections.aplicaveis.count(&:revisado?) %>
        <% total = @pericia.laudo_sections.aplicaveis.count %>
        <div class="mb-2">
          <div class="progress" style="height: 8px;">
            <div class="progress-bar bg-success" style="width: <%= total > 0 ? (revisadas * 100 / total) : 0 %>%"></div>
          </div>
          <small class="text-muted"><%= revisadas %>/<%= total %> seções revisadas</small>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-3">
    <%= link_to "Voltar para perícias", pericias_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

</div>
