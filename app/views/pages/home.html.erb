<% content_for :title, "Início" %>
<% content_for :description, "Plataforma de geração automatizada de laudos técnicos periciais trabalhistas de insalubridade e periculosidade com inteligência artificial." %>

<div class="banner" style="background-image: url(<%= asset_url('banner1.png') %>);"></div>

<div class="container text-center mt-5">
  <p class="lead text-muted mb-4">
    Geração automatizada de laudos técnicos periciais de insalubridade e periculosidade
    com inteligência artificial.
  </p>
  <% if user_signed_in? %>
    <%= link_to "Minhas Perícias", pericias_path, class: "btn btn-primary btn-lg" %>
  <% else %>
    <div class="d-flex justify-content-center gap-3">
      <%= link_to "Entrar", new_user_session_path, class: "btn btn-primary btn-lg" %>
      <%= link_to "Criar conta", new_user_registration_path, class: "btn btn-outline-secondary btn-lg" %>
    </div>
  <% end %>
</div>
