<div class="container mt-5">
  <div class="row justify-content-center text-center">
    <div class="col-md-8">
      <h1 class="mb-3">Plataforma de Laudos Periciais</h1>
      <p class="lead text-muted mb-4">
        Geração automatizada de laudos técnicos periciais de insalubridade e periculosidade
        com inteligência artificial.
      </p>
      <% if user_signed_in? %>
        <%= link_to "Minhas Perícias", pericias_path, class: "btn btn-primary btn-lg" %>
      <% else %>
        <div class="d-flex justify-content-center gap-3">
          <%= link_to "Entrar", new_user_session_path, class: "btn btn-primary btn-lg" %>
          <%= link_to "Criar conta", new_user_registration_path, class: "btn btn-outline-secondary btn-lg" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
